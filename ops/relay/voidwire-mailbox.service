[Unit]
Description=Voidwire group-log mailbox
After=network-online.target iroh-relay.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/voidwire-mailbox --config /etc/voidwire-mailbox/config.toml
Environment=RUST_LOG=off
StandardOutput=null
StandardError=null
DynamicUser=yes
StateDirectory=voidwire-mailbox
StateDirectoryMode=0700
WorkingDirectory=/var/lib/voidwire-mailbox
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
LimitNOFILE=65536
LimitCORE=0
MemoryMax=200M
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
