# Voidwire relay settings. Copy to .env next to compose.yml and edit:
#   cp .env.example .env
# Docker Compose reads .env automatically. On every start the setup service
# builds the relay and mailbox configs from these values (docs/self-host-relay.md §5).
# If config/relay.toml or config/mailbox.toml exists, that file is used
# instead and the values here are ignored for it.
#
# Never put the access token here: it lives only in config/relay-token
# (environment values show up in `docker inspect`).

# Your relay's public name (DNS points here). The apps reach it as
# https://<name>.
VOIDWIRE_RELAY_HOSTNAME=relay.example.com

# How TLS works (guide §3):
#   tls    mode A: the relay gets its own Let's Encrypt certificate on 443
#   proxy  mode B: an HTTPS-terminating proxy in front; the relay listens
#          on plain HTTP at VOIDWIRE_RELAY_PROXY_BIND
VOIDWIRE_RELAY_MODE=tls

# Mode A: email address for Let's Encrypt.
VOIDWIRE_RELAY_CONTACT=you@example.com

# Mode A: false if you can't forward UDP 7842 to this host (guide §2).
# Mode B never uses UDP.
VOIDWIRE_RELAY_UDP=true

# Who may use the relay (guide §4):
#   token  only devices with your relay link (default)
#   open   anyone who knows the name
VOIDWIRE_RELAY_ACCESS=token

# Mode B: where the relay listens for the proxy. Loopback if the proxy runs
# on this host; otherwise this host's LAN address (and firewall it).
#VOIDWIRE_RELAY_PROXY_BIND=127.0.0.1:3340

# ---- Limits (optional). Leave empty for the default shown. ----------------
# Whole numbers. 1 MB = 1048576 bytes, 1 KB = 1024 bytes. These apply only to
# the config built from this file (not to your own config/*.toml).

# Largest file the apps may send through this relay, in MB (default 25).
# 0 = the 2048 MB maximum. Devices on the same network don't use the relay.
VOIDWIRE_RELAY_FILE_LIMIT_MB=

# Upload speed through the relay, per device, in KB per second (default 1024,
# about 1 MB/s). Bursts of 4x are allowed. 0 = no limit. A 200 MB file takes
# about 3 minutes at the default.
VOIDWIRE_RELAY_DEVICE_RATE_KB=

# New connections the relay accepts per second, all devices together
# (default 50, bursts of 4x).
VOIDWIRE_RELAY_NEW_CONN_PER_SEC=

# Offline inbox (items held in RAM for a device that's offline):
# items per device (default 16, 1-256), minutes an item is kept (default 60,
# up to 10080 = 7 days) and MB of RAM for all inboxes together (default 32,
# up to 1024; the oldest items go first when it's full).
VOIDWIRE_RELAY_INBOX_ITEMS=
VOIDWIRE_RELAY_INBOX_MINUTES=
VOIDWIRE_RELAY_INBOX_RAM_MB=
