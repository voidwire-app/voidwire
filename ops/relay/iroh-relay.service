[Unit]
Description=Voidwire relay (iroh-relay 1.3.0)
Documentation=https://github.com/n0-computer/iroh/tree/main/iroh-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/config.toml
Environment=RUST_LOG=off
StandardOutput=null
StandardError=null
DynamicUser=yes
StateDirectory=iroh-relay
StateDirectoryMode=0700
WorkingDirectory=/var/lib/iroh-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
LimitNOFILE=1048576
LimitCORE=0
MemoryMax=700M
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
