{
  "$schema": "voidwire-ui-tokens/1",
  "name": "voidwire",
  "version": "1.1.1",
  "notes": [
    "Source of truth. Run `python3 build_tokens.py` to regenerate tokens.css and compose/*.kt. Do not hand-edit the generated files.",
    "Dark is the default everywhere. Light applies only when the OS explicitly reports light.",
    "Color role names are the Material 3 ColorScheme property names. CSS: --vw-color-<kebab-role>. Kotlin: ColorScheme.<role>. Example: onPrimaryContainer = --vw-color-on-primary-container.",
    "Roles under `extended` are not in Material 3. Compose exposes them through VoidwireTheme.extended.<role>; CSS uses the same --vw-color-<kebab-role> pattern.",
    "Round 2 (1.1.0): added chamfer, chamferCorners, componentShape, m3Shapes and themeMode. Nothing renamed."
  ],
  "color": {
    "dark": {
      "primary": "#F2C94C",
      "onPrimary": "#1A1400",
      "primaryContainer": "#3A2F0A",
      "onPrimaryContainer": "#FFE59A",
      "inversePrimary": "#8C6A00",
      "secondary": "#3D8BFF",
      "onSecondary": "#021433",
      "secondaryContainer": "#0E2550",
      "onSecondaryContainer": "#BBD5FF",
      "tertiary": "#C9D1DB",
      "onTertiary": "#0A1020",
      "tertiaryContainer": "#262F3B",
      "onTertiaryContainer": "#E3E8EE",
      "background": "#070B14",
      "onBackground": "#E3E8EE",
      "surface": "#070B14",
      "onSurface": "#E3E8EE",
      "surfaceVariant": "#1A2333",
      "onSurfaceVariant": "#8E9AAB",
      "surfaceTint": "#3D8BFF",
      "inverseSurface": "#E3E8EE",
      "inverseOnSurface": "#0F1624",
      "error": "#FF6B6B",
      "onError": "#2D0003",
      "errorContainer": "#4A1418",
      "onErrorContainer": "#FFD9D6",
      "outline": "#56647A",
      "outlineVariant": "#1E2839",
      "scrim": "#000000",
      "surfaceBright": "#1F2A3D",
      "surfaceDim": "#070B14",
      "surfaceContainerLowest": "#04070D",
      "surfaceContainerLow": "#0B111D",
      "surfaceContainer": "#0F1624",
      "surfaceContainerHigh": "#141D2E",
      "surfaceContainerHighest": "#1A2438"
    },
    "light": {
      "primary": "#F2C94C",
      "onPrimary": "#1A1405",
      "primaryContainer": "#F2C94C",
      "onPrimaryContainer": "#1A1405",
      "inversePrimary": "#8C6A00",
      "secondary": "#1F5FD1",
      "onSecondary": "#FFFFFF",
      "secondaryContainer": "#D8E5FF",
      "onSecondaryContainer": "#0A2A66",
      "tertiary": "#4F5A66",
      "onTertiary": "#FFFFFF",
      "tertiaryContainer": "#DCE2E9",
      "onTertiaryContainer": "#1C2530",
      "background": "#F4F6F9",
      "onBackground": "#0A1020",
      "surface": "#F4F6F9",
      "onSurface": "#0A1020",
      "surfaceVariant": "#E1E6ED",
      "onSurfaceVariant": "#4F5A66",
      "surfaceTint": "#1F5FD1",
      "inverseSurface": "#141D2E",
      "inverseOnSurface": "#E3E8EE",
      "error": "#BA1A1A",
      "onError": "#FFFFFF",
      "errorContainer": "#FFDAD6",
      "onErrorContainer": "#410002",
      "outline": "#77849A",
      "outlineVariant": "#CBD3DD",
      "scrim": "#000000",
      "surfaceBright": "#FFFFFF",
      "surfaceDim": "#D9DEE5",
      "surfaceContainerLowest": "#FFFFFF",
      "surfaceContainerLow": "#F9FAFC",
      "surfaceContainer": "#EEF1F5",
      "surfaceContainerHigh": "#E8ECF1",
      "surfaceContainerHighest": "#E1E6ED"
    }
  },
  "extended": {
    "dark": {
      "success": "#3DDC97",
      "onSuccess": "#00210F",
      "successContainer": "#0D3324",
      "onSuccessContainer": "#B4F5D6",
      "warning": "#FFA94D",
      "onWarning": "#2B1500",
      "warningContainer": "#3D2410",
      "onWarningContainer": "#FFDDB8",
      "wire": "#3D8BFF",
      "relay": "#F2C94C",
      "node": "#C9D1DB",
      "plate": "#070B14",
      "focusRing": "#3D8BFF"
    },
    "light": {
      "success": "#0F7A4D",
      "onSuccess": "#FFFFFF",
      "successContainer": "#CDF3E1",
      "onSuccessContainer": "#00210F",
      "warning": "#8A4B00",
      "onWarning": "#FFFFFF",
      "warningContainer": "#FFE2C7",
      "onWarningContainer": "#2B1500",
      "wire": "#1F5FD1",
      "relay": "#8C6A00",
      "node": "#4F5A66",
      "plate": "#070B14",
      "focusRing": "#1F5FD1"
    }
  },
  "font": {
    "family": {
      "sans": {
        "name": "Space Grotesk",
        "css": "\"Space Grotesk\", \"Segoe UI Variable Text\", \"Segoe UI\", system-ui, sans-serif",
        "android": "space_grotesk"
      },
      "mono": {
        "name": "JetBrains Mono",
        "css": "\"JetBrains Mono\", \"Cascadia Mono\", Consolas, ui-monospace, monospace",
        "android": "jetbrains_mono"
      }
    }
  },
  "typography": {
    "displaySmall": {
      "family": "sans",
      "size": 36,
      "lineHeight": 44,
      "weight": 600,
      "tracking": -0.01
    },
    "headlineMedium": {
      "family": "sans",
      "size": 28,
      "lineHeight": 36,
      "weight": 600,
      "tracking": -0.01
    },
    "headlineSmall": {
      "family": "sans",
      "size": 24,
      "lineHeight": 32,
      "weight": 600,
      "tracking": -0.005
    },
    "titleLarge": {
      "family": "sans",
      "size": 20,
      "lineHeight": 28,
      "weight": 600,
      "tracking": 0
    },
    "titleMedium": {
      "family": "sans",
      "size": 16,
      "lineHeight": 24,
      "weight": 600,
      "tracking": 0.005
    },
    "titleSmall": {
      "family": "sans",
      "size": 14,
      "lineHeight": 20,
      "weight": 600,
      "tracking": 0.005
    },
    "bodyLarge": {
      "family": "sans",
      "size": 16,
      "lineHeight": 24,
      "weight": 400,
      "tracking": 0
    },
    "bodyMedium": {
      "family": "sans",
      "size": 14,
      "lineHeight": 20,
      "weight": 400,
      "tracking": 0
    },
    "bodySmall": {
      "family": "sans",
      "size": 12,
      "lineHeight": 16,
      "weight": 400,
      "tracking": 0.01
    },
    "labelLarge": {
      "family": "sans",
      "size": 14,
      "lineHeight": 20,
      "weight": 600,
      "tracking": 0.02
    },
    "labelMedium": {
      "family": "mono",
      "size": 11,
      "lineHeight": 16,
      "weight": 500,
      "tracking": 0.08
    },
    "labelSmall": {
      "family": "mono",
      "size": 10,
      "lineHeight": 14,
      "weight": 500,
      "tracking": 0.08
    },
    "codeLarge": {
      "family": "mono",
      "size": 40,
      "lineHeight": 48,
      "weight": 500,
      "tracking": 0.06,
      "extended": true
    },
    "codeMedium": {
      "family": "mono",
      "size": 14,
      "lineHeight": 20,
      "weight": 400,
      "tracking": 0,
      "extended": true
    },
    "codeSmall": {
      "family": "mono",
      "size": 12,
      "lineHeight": 16,
      "weight": 400,
      "tracking": 0,
      "extended": true
    }
  },
  "space": {
    "0": 0,
    "0-5": 2,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "shape": {
    "none": 0,
    "extraSmall": 4,
    "small": 6,
    "medium": 10,
    "large": 14,
    "extraLarge": 20,
    "full": 999
  },
  "chamfer": {
    "sm": 4,
    "md": 8,
    "lg": 12
  },
  "chamferCorners": {
    "signature": [
      "topStart",
      "bottomEnd"
    ],
    "all": [
      "topStart",
      "topEnd",
      "bottomEnd",
      "bottomStart"
    ],
    "bottomEnd": [
      "bottomEnd"
    ]
  },
  "componentShape": {
    "primaryButton": {
      "kind": "chamfer",
      "size": "md",
      "corners": "signature",
      "note": "Filled gold action. Also the armed destructive (Click again to forget)."
    },
    "card": {
      "kind": "chamfer",
      "size": "lg",
      "corners": "signature",
      "note": "Device/PC cards, settings cards, info cards."
    },
    "codeCell": {
      "kind": "chamfer",
      "size": "md",
      "corners": "signature",
      "note": "Each of the 6 SAS digit boxes (desktop entry + Android display)."
    },
    "chip": {
      "kind": "chamfer",
      "size": "sm",
      "corners": "all",
      "note": "Status tags (REACHABLE, REMOVED, LINK OK, Listening)."
    },
    "windowHeader": {
      "kind": "chamfer",
      "size": "lg",
      "corners": "bottomEnd",
      "note": "In-window header band under the native caption (desktop only)."
    },
    "segmented": {
      "kind": "chamfer",
      "size": "sm",
      "corners": "signature",
      "note": "Tab and theme segmented controls (container). Selected segment is sharp (radius 0)."
    },
    "iconWell": {
      "kind": "rounded",
      "radius": 2,
      "note": "Device icon tiles: near-sharp."
    },
    "secondaryButton": {
      "kind": "rounded",
      "radius": "small",
      "note": "Outline / tonal / text buttons on both platforms (no pills)."
    },
    "input": {
      "kind": "rounded",
      "radius": "small",
      "note": "Text fields."
    },
    "toast": {
      "kind": "rounded",
      "radius": "medium",
      "note": "Desktop toast, Android snackbar."
    },
    "dialog": {
      "kind": "rounded",
      "radius": "extraLarge",
      "note": "Desktop has none; Android AlertDialog and the Share dialog card."
    },
    "switch": {
      "kind": "rounded",
      "radius": "full",
      "note": "Switch track and thumb stay round."
    }
  },
  "m3Shapes": {
    "extraSmall": {
      "kind": "rounded",
      "radius": "extraSmall",
      "usedBy": "text fields, menus, snackbar, tooltips"
    },
    "small": {
      "kind": "chamfer",
      "size": "sm",
      "corners": "all",
      "usedBy": "chips"
    },
    "medium": {
      "kind": "chamfer",
      "size": "lg",
      "corners": "signature",
      "usedBy": "cards"
    },
    "large": {
      "kind": "rounded",
      "radius": "large",
      "usedBy": "sheets, FAB, drawers"
    },
    "extraLarge": {
      "kind": "rounded",
      "radius": "extraLarge",
      "usedBy": "dialogs"
    }
  },
  "elevation": {
    "level0": {
      "dp": 0,
      "css": "none"
    },
    "level1": {
      "dp": 1,
      "css": "0 1px 2px rgba(0,0,0,.40)"
    },
    "level2": {
      "dp": 3,
      "css": "0 2px 6px rgba(0,0,0,.45)"
    },
    "level3": {
      "dp": 6,
      "css": "0 6px 16px rgba(0,0,0,.50)"
    },
    "level4": {
      "dp": 8,
      "css": "0 10px 24px rgba(0,0,0,.55)"
    },
    "level5": {
      "dp": 12,
      "css": "0 16px 40px rgba(0,0,0,.60)"
    }
  },
  "motion": {
    "durationShort": 120,
    "durationMedium": 200,
    "durationLong": 320,
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easingEmphasizedDecelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)"
  },
  "component": {
    "minTouchTarget": 48,
    "desktopControlHeight": 32,
    "focusRingWidth": 2,
    "borderHairline": 1
  },
  "themeMode": {
    "values": [
      "dark",
      "system",
      "light"
    ],
    "default": "dark",
    "system": "Follow the OS. Dark when the OS reports nothing or anything other than an explicit light setting.",
    "storage": {
      "desktop": "settings.theme (string)",
      "android": "SharedPreferences 'ui' / 'theme_mode' (string)"
    }
  }
}
